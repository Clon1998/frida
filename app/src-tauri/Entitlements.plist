<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of signed macOS builds (PLAN.md M13). They must match the embedded provisioning
  profile (team Q4XB68D4T7, App ID io.github.clon1998.frida), or macOS refuses to start the app.
  keychain-access-groups gives Frida its own group in the data protection keychain, so reading
  secrets never asks for the password.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>Q4XB68D4T7.io.github.clon1998.frida</string>
	<key>com.apple.developer.team-identifier</key>
	<string>Q4XB68D4T7</string>
	<key>keychain-access-groups</key>
	<array>
		<string>Q4XB68D4T7.io.github.clon1998.frida</string>
	</array>
</dict>
</plist>
