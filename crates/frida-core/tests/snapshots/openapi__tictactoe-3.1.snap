    name: Gameplay
    seq: 0
    vars: []
    headers: []
    auth:
      mode: inherit
    scripts:
      pre: ""
      post: ""
    tests: ""
    settings:
      timeoutMs: null
    docs: ""
  requests:
  - version: 1
    name: Get the whole board
    seq: 0
    method: GET
    url: "{{baseUrl}}/board"
    params:
      query: []
      path: []
    headers: []
    body:
      mode: none
      json: ""
      xml: ""
      text: ""
      formUrlEncoded: []
      multipart: []
      binaryPath: ""
    auth:
      mode: custom
      schemes:
      - type: apikey
        in: header
        name: api-key
        value: "{{defaultApiKey}}"
    vars: []
    scripts:
      pre: ""
      post: ""
    tests: ""
    settings:
      timeoutMs: null
    docs: |-
      Retrieves the current state of the board and the winner.
      
      Operation id: `get-board`
  - version: 1
    name: Get a single board square
    seq: 0
    method: GET
    url: "{{baseUrl}}/board/:row/:column"
    params:
      query: []
      path:
      - name: row
        value: "1"
      - name: column
        value: "1"
    headers: []
    body:
      mode: none
      json: ""
      xml: ""
      text: ""
      formUrlEncoded: []
      multipart: []
      binaryPath: ""
    auth:
      mode: custom
      schemes:
      - type: bearer
        token: "{{token}}"
    vars: []
    scripts:
      pre: ""
      post: ""
    tests: ""
    settings:
      timeoutMs: null
    docs: |-
      Retrieves the requested square.
      
      Operation id: `get-square`
  - version: 1
    name: Set a single board square
    seq: 0
    method: PUT
    url: "{{baseUrl}}/board/:row/:column"
    params:
      query: []
      path:
      - name: row
        value: "1"
      - name: column
        value: "1"
    headers:
    - name: progressUrl
      value: ""
      enabled: false
    body:
      mode: json
