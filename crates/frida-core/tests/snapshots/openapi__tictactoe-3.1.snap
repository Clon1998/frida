      schemes:
      - type: bearer
        token: "{{token}}"
    vars: []
    scripts:
      pre: ""
      post: ""
    tests: ""
    settings:
      timeoutMs: null
    docs: |-
      Places a mark on the board and retrieves the whole board and the winner (if any).
      
      Operation id: `put-square`
requests: []
summary:
  collectionName: Tic Tac Toe
