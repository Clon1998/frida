---
/** The feature grid on the landing page. Keep it in step with the README's feature list. */
import { Icon } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";

const base = import.meta.env.BASE_URL;

const features: { icon: StarlightIcon; title: string; text: string; link?: string }[] = [
  {
    icon: "document",
    title: "Files, not a database",
    text: "One YAML file per request, with clean diffs. Headers, auth, variables and scripts are inherited from collection to folder to request.",
    link: "guides/file-format/",
  },
  {
    icon: "list-format",
    title: "Environments you can see through",
    text: "Variables on six layers. The inspector shows every {{variable}} a request uses, its value, where it comes from and what it shadows.",
    link: "guides/user-guide/",
  },
  {
    icon: "padlock",
    title: "Secrets stay out of git",
    text: "Only secret: true is written. Values live in the macOS Keychain, Windows Credential Manager or Linux Secret Service, or come from AWS.",
    link: "guides/user-guide/",
  },
  {
    icon: "approve-check",
    title: "Auth that refreshes itself",
    text: "Basic, Bearer, API key and OAuth2 (client credentials, password, authorization code + PKCE, Cognito), also combined. Tokens are cached and refreshed.",
    link: "guides/user-guide/",
  },
  {
    icon: "puzzle",
    title: "Scripts and tests",
    text: "JavaScript before and after each request, in a sandbox, with an API compatible with Bruno's bru/req/res.",
    link: "guides/scripting/",
  },
  {
    icon: "rocket",
    title: "Collection runner",
    text: "Run a collection or folder in order. Scripts can skip, jump or stop. The same run works headless with frida-run.",
    link: "guides/cli/",
  },
  {
    icon: "code-branch",
    title: "Git built in",
    text: "Status, side-by-side diffs, stage, commit, push, pull and branches, with your own git and SSH keys.",
    link: "guides/user-guide/",
  },
  {
    icon: "add-document",
    title: "Import and export",
    text: "Bring in OpenAPI 3.0/3.1, Bruno collections and curl commands. Copy any request as curl for bash or PowerShell.",
    link: "guides/user-guide/",
  },
  {
    icon: "cloud-download",
    title: "AWS, proxies, the works",
    text: "Secrets Manager, Cognito and API Gateway keys as variable sources. System, manual or SOCKS5 proxies. History, cookies, JSONPath filter.",
    link: "guides/user-guide/",
  },
];
---

<div class="features not-content">
  {
    features.map((f) => (
      <a class="feature" href={f.link ? `${base}${f.link}` : undefined}>
        <Icon name={f.icon} size="1.5rem" class="icon" />
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </a>
    ))
  }
</div>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .feature:hover {
    border-color: var(--sl-color-accent);
  }
  .feature :global(.icon) {
    padding: 0.4rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    box-sizing: content-box;
  }
  h3 {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
